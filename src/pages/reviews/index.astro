---
import Layout from '../../layouts/Layout.astro';

type Review = {
    url?: string;
    frontmatter: {
        title: string;
        summary?: string;
        date?: string;
        label?: string;
        thumb?: string;
    };
};

// このフォルダの .md を全部集める
const modules = import.meta.glob<Review>('./*.md', { eager: true });

const reviews = Object.entries(modules)
    // 「_」で始まるファイル（ひな形）を除く
    .filter(([path]) => !path.includes('/_'))
    .map(([, mod]) => mod)
    // 新しい順に並べる
    .sort((a, b) => ((a.frontmatter.date ?? '') < (b.frontmatter.date ?? '') ? 1 : -1));

// 2027-02-01 → 2027 / 02 / 01 に整形する。
// ★date: 2027-02-01 のような書き方はYAMLが日付として解釈し、
//   glob() を通る過程で "2027-02-01T00:00:00.000Z" という文字列になる。
//   最初の10文字（YYYY-MM-DD の部分）だけを使えば時刻の分は無視できる
function formatDate(date?: string) {
    if (!date) return '';
    return date.slice(0, 10).replaceAll('-', ' / ');
}
---

<Layout title="Reviews | しーのホームページ">

    <h1>Reviews</h1>
    <p class="lead">uec_reviewなど順次更新予定。</p>

    {reviews.length > 0 ? (
        <ul class="reviewlist">
            {reviews.map((r) => (
                <li>
                    <a href={r.url}>

                        <!-- サムネの枠。thumbを書いていない記事は
                             labelの文字（無ければタイトルの頭文字）を大きく出す。
                             画像を作らなくても記事を書き始められるようにするため -->
                        <div class="reviewlist__thumb">
                            {r.frontmatter.thumb
                                ? <img src={r.frontmatter.thumb} alt="" />
                                : <span>{r.frontmatter.label ?? [...r.frontmatter.title][0]}</span>}
                        </div>

                        <div class="reviewlist__body">
                            {r.frontmatter.date && <time>{formatDate(r.frontmatter.date)}</time>}
                            <b>{r.frontmatter.title}</b>
                            {r.frontmatter.summary && <p>{r.frontmatter.summary}</p>}
                        </div>

                    </a>
                </li>
            ))}
        </ul>
    ) : (
        <p class="empty">まだ記事がありません。</p>
    )}

</Layout>

<style>
    .lead { font-size: 0.85rem; color: var(--muted); margin: 0 0 1.6rem; }

    .reviewlist { border-top: 1px solid var(--line); margin: 0; padding: 0; }

    .reviewlist a {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 18px 0;
        border-bottom: 1px solid var(--line);
        color: inherit;
        text-decoration: none;
    }

    /* サムネ全体を少し前に出す。ホバーで文字だけ色を変えると
       サムネが浮いて見えるので、枠線もアクセント色に変える */
    .reviewlist__thumb {
        width: 132px;
        height: 88px;
        flex-shrink: 0;         /* タイトルが長くても押し潰されない */
        display: grid;
        place-items: center;
        background: var(--bg);
        border: 1px solid var(--line);
        transition: border-color 0.2s ease;
    }

    .reviewlist a:hover .reviewlist__thumb { border-color: var(--accent); }

    .reviewlist__thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .reviewlist__thumb span {
        font-family: var(--font-display);
        font-size: 0.85rem;
        letter-spacing: 0.08em;
        color: var(--accent);
        text-align: center;
        padding: 0 8px;
    }

    /* min-width: 0 が無いと、長いタイトルがサムネを押し縮める */
    .reviewlist__body { min-width: 0; }

    .reviewlist__body time {
        display: block;
        font-family: var(--font-display);
        font-size: 0.7rem;
        letter-spacing: 0.12em;
        color: var(--muted);
        margin-bottom: 2px;
    }

    .reviewlist__body b {
        display: block;
        font-weight: 500;
        font-size: 1.15rem;
        transition: color 0.2s ease;
    }

    .reviewlist a:hover .reviewlist__body b { color: var(--accent); }

    .reviewlist__body p {
        margin: 4px 0 0;
        font-size: 0.85rem;
        color: var(--muted);
    }

    .empty {
        border: 1px dashed var(--line);
        padding: 1.6rem;
        text-align: center;
        font-size: 0.85rem;
        color: var(--muted);
    }

    /* ============================================================
       狭い画面向けの調整　★必ずファイルの最後に置くこと★
       ============================================================ */
    @media (max-width: 480px) {
        .reviewlist__thumb { width: 88px; height: 66px; }
        .reviewlist__body b { font-size: 1rem; }
    }
</style>
