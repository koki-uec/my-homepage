---
import Layout from '../layouts/Layout.astro'; 
import StatCard from '../components/StatCard.astro';
import darts from '../data/darts.json';
import Board from '../components/Board.astro';
---

<Layout title="About | しーのホームページ">
    <h1>自己紹介</h1>

    <div class="intro">
        <figure class="intro__icon">
            <img src="/images/icon.jpg" alt="プロフィール写真" class="profile-img" />
            <figcaption>好きな曲のイメージキャラクター</figcaption>
        </figure>
        <p class="intro__text">しーと言います。ゲー障がダーツにはまってダー障になりました。軽音系の部活でドラムを叩いてます。最近は基本情報技術者試験とAtCoderに向けて精進中。</p>
    </div>


<dl class="profile">
    <div>
        <dt>Name</dt>
        <dd>しー</dd>
    </div>
    <div>
        <dt>Belonging</dt>
        <dd>軽音楽部/器楽部/シンセデザイン研究部</dd>
    </div>
    <div>
        <dt>Birthday</dt>
        <dd>2007/06/20</dd>
    </div>
    <div>
        <dt>Hobby</dt>
        <dd>ダーツ/ドラム/ゲーム</dd>
    </div>
    <div>
        <dt>Games</dt>
        <dd>Overwatch/Slay the spire2/Shadowverse/</dd>
    </div>
</dl>

<h2>MY GEAR</h2>
<p class="lead">使っているダーツ一式</p>

<div class="gear">
    <div class="gear__item">
        <p class="gear__tag">BARREL</p>
        <h3>LAZY Type2 TORPEDO</h3>
        <img src="/images/lazy.jpg" alt="LAZY Type2 TORPEDO" />
    </div>

    <div class="gear__item">
        <p class="gear__tag">FLIGHT / SHAFT</p>
        <h3>TARGET K-FLEX シェイプ インターミディエイト</h3>
        <img src="/images/flight.jpg" alt="TARGET K-FLEX シェイプ" />
    </div>

    <div class="gear__item">
        <p class="gear__tag">TIP</p>
        <h3>Premium Lip point</h3>
        <img src="/images/tip.jpg" alt="Premium Lip point" />
    </div>
</div>

<figure class="gear__result">
    <img src="/images/darts.jpg" alt="組み上げたダーツ" />
    <figcaption>できあがり✨</figcaption>
</figure>

<h2>STATS</h2>
<p>DARTSLIVE3のスタッツ</p>
<div class="figures">
    <StatCard label="RATING" value={darts.rating} note={darts.flight}/>
    <StatCard label="01 GAMES" value={darts.stats01} />
    <StatCard label="CRICKET" value={darts.cricket} />
</div>

<p class="updated">UPDATED {darts.updated}</p>

<Board />

<div class="social-links" slot="outside">
    <a href="https://x.com/c_chaaan" target="_blank" rel="noopener noreferrer">
        Twitter (X)
    </a>

    <a href="https://www.instagram.com/t.lvb2o" target="_blank" rel="noopener noreferrer">
		Instagram
	</a>

     <a href="https://link.studyplus.jp/DWPWYwQ7" target="_blank" rel="noopener noreferrer">
		Studyplus
	</a>
</div>

</Layout>

<style>
    /* 上部。アイコンとキャプションと本文がバラバラの行になっていたので、
       Homeと同じ「写真は左、文章は右」の形に揃えました */
    .intro {
        display: flex;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 2.2rem;
    }

    .intro__icon { margin: 0; flex-shrink: 0; width: 88px; }

    .intro__icon figcaption {
        font-size: 0.62rem;
        line-height: 1.5;
        color: var(--muted);
        margin-top: 6px;
    }

    .intro__text { margin: 0; font-size: 0.95rem; }

    .profile-img {
        width: 88px;
        height: 88px;
        border-radius: 50%;
        object-fit: cover;
        display: block;
    }

    /* 見出しの下の一言 */
    .lead {
        font-size: 0.85rem;
        color: var(--muted);
        margin: 0 0 1rem;
    }

    /* --- MY GEAR ---
       旧サイトと同じ「タグ＋製品名＋写真」の形。
       枠ではなく上の罫線1本で区切るので、サイトの他と揃います */
    .gear {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1.2rem;
        margin-bottom: 1.2rem;
    }

    /* ★写真の下端を揃える仕組み★
       製品名の行数がバラバラなので、そのままだと写真の位置もずれます。
       カードを縦のフレックスにして、写真に margin-top: auto を掛けると
       「余った隙間が全部 写真の上」に集まり、写真が下端に貼り付きます。
       カード自体はグリッドが同じ高さに揃えてくれるので、結果として下端が一直線に。 */
    .gear__item {
        display: flex;
        flex-direction: column;
        align-items: flex-start;   /* 中身は左揃えのまま */
        border-top: 1px solid var(--line);
        padding-top: 0.7rem;
    }

    .gear__tag {
        font-family: var(--font-display);
        font-size: 0.65rem;
        letter-spacing: 0.16em;
        color: var(--accent);
        margin: 0 0 0.3rem;
    }

    .gear__item h3 {
        font-size: 0.85rem;
        font-weight: 400;
        line-height: 1.6;
        margin: 0 0 0.6rem;
    }

    /* ★正方形に揃えないこと★
       商品写真は縦横比がバラバラなので、正方形に押し込むと
       白い枠の中に細い線が浮くだけになります。上限だけ決めて比率は任せます */
    .gear__item img {
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: 110px;
        border: 1px solid var(--line);
        margin-top: auto;      /* 余白を上に寄せて、写真を下端へ */
    }

    /* 組み上がりの写真とキャプションを、ひとかたまりで中央に。
       margin-inline: auto が「左右の余白を等分にする」＝中央寄せです */
    .gear__result {
        max-width: 360px;
        margin: 0 auto 2.5rem;
        text-align: center;
    }

    .gear__result img {
        width: 100%;
        height: auto;
        border: 1px solid var(--line);
        display: block;
    }

    .gear__result figcaption {
        font-size: 0.75rem;
        color: var(--muted);
        margin-top: 0.5rem;
    }

    /* スタッツを横並びに。
       3枚が縦に積まれて全幅だったので、1枚あたりの主張が強すぎました。
       auto-fit なので、狭い画面では自動で2列→1列に落ちます */
    .figures {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 0.8rem;
        margin-bottom: 0.7rem;
    }

    /* 旧サイトと同じ、スタッツの下に小さく置く更新日。
       文字は darts.json の updated から来るので、
       数字を書き換えるときに日付も一緒に直せます */
    .updated {
        font-family: var(--font-display);
        font-size: 0.65rem;
        letter-spacing: 0.14em;
        color: var(--muted);
        margin: 0 0 2.5rem;
    }

    .social-links {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
}

.profile {
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
}

.profile > div {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
}

.profile dt {
    flex-shrink: 0;      /* ← これが要 */
    width: 7em;
    color: var(--muted);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
}

.profile dd {
    flex: 1;
}

/* 本のテンプレートの青（#4a90d9）が残っていたので、アクセント変数へ。
   ここを直書きにしておくと、配色を切り替えても取り残されます */
.social-links a {
    padding: 0.4rem 1rem;
    border: 1px solid var(--accent);
    border-radius: 0px;
    color: var(--accent);
    text-decoration: none;
    font-size: 0.9rem;
    transition:
        background-color 0.2s ease,
        color 0.2s ease;
}

.social-links a:hover {
    background-color: var(--accent);
    color: var(--bg);
}

/* ============================================================
   狭い画面向けの調整

   ★必ずファイルの最後に置くこと★
   メディアクエリは詳細度を上げません。同じ強さの指定どうしでは
   「後に書いたほうが勝つ」ので、前に置くと下の .profile dd { flex: 1 }
   などに打ち消されて効きません。実際それで一度効きませんでした。
   ============================================================ */
@media (max-width: 520px) {
    /* プロフィール表を2段に折る。
       横一列のままだと値に123pxしか残らず、部活名が3行に折り返します */
    .profile > div { flex-wrap: wrap; gap: 0.15rem 1rem; }
    .profile dt { width: auto; }
    .profile dd { flex-basis: 100%; }

    /* スタッツは縦3枚だと長いので、2列に収まる幅まで下げる */
    .figures { grid-template-columns: repeat(auto-fit, minmax(118px, 1fr)); }
}

@media (max-width: 420px) {
    .intro { gap: 14px; }
    .intro__icon { width: 68px; }
    .profile-img { width: 68px; height: 68px; }
}
</style>


