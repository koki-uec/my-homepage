---
import Layout from '../layouts/Layout.astro'; 
import StatCard from '../components/StatCard.astro';
import darts from '../data/darts.json';
import Board from '../components/Board.astro';
---

<Layout title="About | しーのホームページ">
    <h1>自己紹介</h1>
    <img src="/images/icon.jpg" alt="プロフィール写真" class="profile-img" />
    <small>これは好きな曲のイメージキャラクターのアイコン</small>
	<p>電気通信大学の1年生です。最近はダーツにハマっています。</p>


<div class="profile">
    <small>
        Name<br>
        しー
        <hr>
        Belonging<br>
        軽音楽部/器楽部/シンセデザイン研究部<br>
        <hr>
        Birthday<br>
        2007/06/20<br>
        <hr>
        Hobby<br>
        ダーツ/ドラム/ゲーム<br>
        <hr>
        Games<br>
        Overwatch/Slay the spire 2/Shadowverse/
    </small>
</div>


<small>スタッツ</small>
<StatCard label="RATING" value={darts.rating} note={darts.flight}/>
<StatCard label="01 GAMES" value={darts.stats01} />
<StatCard label="CRICKET" value={darts.cricket} />

<Board />

<div class="social-links" slot="outside">
    <a href="https://x.com/c_chaaan" target="_blank" rel="noopener noreferrer">
        Twitter (X)
    </a>

    <a href="https://youtube.com/hikakintv" target="_blank" rel="noopener noreferrer">
		Youtube
	</a>
</div>

</Layout>

<style>
    .profile-img {
        width: 70px;
		height: 70px;
		border-radius: 50%;
		object-fit: cover;
    }

    .social-links {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
}

.profile {

}

/* 本のテンプレートの青（#4a90d9）が残っていたので、アクセント変数へ。
   ここを直書きにしておくと、配色を切り替えても取り残されます */
.social-links a {
    padding: 0.4rem 1rem;
    border: 1px solid var(--accent);
    border-radius: 0px;
    color: var(--accent);
    text-decoration: none;
    font-size: 0.9rem;
    transition:
        background-color 0.2s ease,
        color 0.2s ease;
}

.social-links a:hover {
    background-color: var(--accent);
    color: var(--bg);
}
</style>


