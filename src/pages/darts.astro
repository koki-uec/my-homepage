---
import Layout from '../layouts/Layout.astro';
import StatCard from '../components/StatCard.astro';
import darts from '../data/darts.json';
import Board from '../components/Board.astro';
import LogList from '../components/LogList.astro';

import postData from '../data/posts.json';
import gearData from '../data/gear.json';

// Homeとは逆に、ダーツの記録だけをここに出す
const dartsPosts = postData.posts.filter((p) => p.src === 'DARTS');
---

<Layout title="Darts | しーのホームページ">

<h1>ダーツ🎯</h1>
<p>同クラの友達が誘ってくれて始めた結果はちゃめちゃにはまりました。まさかこんなにダーツの沼が深いとは、、</p>


<h2>MY GEAR</h2>
<p class="lead">使っているダーツ一式</p>

<div class="gear">
    {gearData.groups.map((group) => (
        <div class="gear__group">
            <p class="gear__tag">{group.tag}</p>
            <div class="gear__items">
                {group.items.map((item) => (
                    <div class="gear__item">
                        <h3>{item.name}</h3>
                        <img src={item.image} alt={item.name} />
                    </div>
                ))}
            </div>
        </div>
    ))}
</div>

<div class="gear__results">
    {gearData.results.map((result) => (
        <figure class="gear__result">
            <img src={result.image} alt={result.caption} />
            <figcaption>{result.caption}</figcaption>
        </figure>
    ))}
</div>

<h2>STATS</h2>
<p>DARTSLIVE3のスタッツ</p>
<div class="figures">
    <StatCard label="RATING" value={darts.rating} note={darts.flight}/>
    <StatCard label="01 GAMES" value={darts.stats01} />
    <StatCard label="CRICKET" value={darts.cricket} />
</div>

<p class="updated">UPDATED {darts.updated}</p>

<Board />

<LogList posts={dartsPosts} />

<div class="social-links" slot="outside">
    <a href="https://x.com/c_d4rts" target="_blank" rel="noopener noreferrer">
        Twitter (ダーツ垢)
    </a>

</div>

</Layout>

<style>
    /* 上部*/
    .intro {
        display: flex;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 2.2rem;
    }

    .intro__icon { margin: 0; flex-shrink: 0; width: 88px; }

    .intro__icon figcaption {
        font-size: 0.62rem;
        line-height: 1.5;
        color: var(--muted);
        margin-top: 6px;
    }

    .intro__text { margin: 0; font-size: 0.95rem; }

    .profile-img {
        width: 88px;
        height: 88px;
        border-radius: 50%;
        object-fit: cover;
        display: block;
    }

    /* 見出しの下の一言 */
    .lead {
        font-size: 0.85rem;
        color: var(--muted);
        margin: 0 0 1rem;
    }

    /* --- MY GEAR ---
       旧サイトと同じ「タグ＋製品名＋写真」の形。
       枠ではなく上の罫線1本で区切るので、サイトの他と揃います。

       ★パーツごとに複数追加できる形にした★
       以前は BARREL / FLIGHT・SHAFT / TIP の3つを横に並べて、
       それぞれ1個しか置けなかった。マイダーツが増えてきたので、
       「パーツ（タグ）ごとに縦に区切り、その中に複数のアイテムを横に並べる」
       形に変更。同じパーツを増やしたいときは gear.json の items に
       1個足すだけでよい */
    .gear { margin-bottom: 1.2rem; }

    .gear__group {
        border-top: 1px solid var(--line);
        padding-top: 0.7rem;
        margin-bottom: 1.2rem;
    }
    .gear__group:last-child { margin-bottom: 0; }

    .gear__tag {
        font-family: var(--font-display);
        font-size: 0.65rem;
        letter-spacing: 0.16em;
        color: var(--accent);
        margin: 0 0 0.7rem;
    }

    /* 同じパーツのアイテムを横に並べる。
       auto-fit ではなく wrap を使っているのは、アイテムが1個しか無い
       パーツまで幅いっぱいに間延びさせたくないため。

       ★かたまりごと中央に置く★
       これが無いと、1行に収まらない個数のときに最後の行だけ
       左に貼り付いて右側が空く＝スマホで「全部左寄り」に見える原因になる。
       ダーツ盤のスコア欄・できあがり写真と同じ直し方 */
    .gear__items {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1.2rem;
    }

    /* ★写真の下端を揃える仕組み★
       製品名の行数がバラバラなので、そのままだと写真の位置もずれます。
       カードを縦のフレックスにして、写真に margin-top: auto を掛けると
       「余った隙間が全部 写真の上」に集まり、写真が下端に貼り付きます。
       .gear__items 側が display:flex（横並び）なので、既定の
       align-items: stretch が効いて各カードの高さが自動で揃い、
       結果として下端も一直線になります */
    .gear__item {
        display: flex;
        flex-direction: column;
        align-items: flex-start;   /* 中身は左揃えのまま */
        flex: 0 1 180px;
    }

    .gear__item h3 {
        font-size: 0.85rem;
        font-weight: 400;
        line-height: 1.6;
        margin: 0 0 0.6rem;
    }

    /* ★正方形に揃えないこと★
       商品写真は縦横比がバラバラなので、正方形に押し込むと
       白い枠の中に細い線が浮くだけになります。上限だけ決めて比率は任せます */
    .gear__item img {
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: 110px;
        border: 1px solid var(--line);
        margin-top: auto;      /* 余白を上に寄せて、写真を下端へ */
    }

    /* 組み上がりの写真。複数枚あるときは横に並べて折り返す。
       ★かたまりごと中央に置く★ justify-content: center で
       1枚のときは今までどおり中央、複数枚のときは横並びのかたまりごと中央になる。

       ★下端を揃える★
       写真ごとに縦横比がバラバラ（縦長・横長混在）だと、幅を揃えても
       高さが不揃いになりPCでガタつく。align-items: flex-end で
       写真の下端（＝キャプションの開始位置）を揃えることで、
       高さが違っても足並みが揃って見える */
    .gear__results {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: flex-end;
        gap: 1.4rem;
        margin-bottom: 2.5rem;
    }

    .gear__result {
        flex: 0 1 auto;
        max-width: 260px;
        text-align: center;
    }

    /* ★幅ではなく高さを揃える★
       width:100%固定だと、縦長の写真は横長の写真よりずっと背が高くなる。
       高さの上限を決めて幅は比率任せにすれば、縦長・横長が混在しても
       写真自体の背丈がある程度揃う（MY GEARの商品写真と同じ考え方） */
    .gear__result img {
        display: block;
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: 220px;
        margin: 0 auto;
        border: 1px solid var(--line);
    }

    .gear__result figcaption {
        font-size: 0.75rem;
        color: var(--muted);
        margin-top: 0.5rem;
    }

    /* スタッツを横並びに。
       3枚が縦に積まれて全幅だったので、1枚あたりの主張が強すぎました。
       auto-fit なので、狭い画面では自動で2列→1列に落ちます */
    .figures {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 0.8rem;
        margin-bottom: 0.7rem;
    }

    /* 旧サイトと同じ、スタッツの下に小さく置く更新日。
       文字は darts.json の updated から来るので、
       数字を書き換えるときに日付も一緒に直せます */
    .updated {
        font-family: var(--font-display);
        font-size: 0.65rem;
        letter-spacing: 0.14em;
        color: var(--muted);
        margin: 0 0 2.5rem;
    }

    .social-links {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
}

.profile {
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
}

.profile > div {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
}

.profile dt {
    flex-shrink: 0;      /* ← これが要 */
    width: 7em;
    color: var(--muted);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
}

.profile dd {
    flex: 1;
}

/* 本のテンプレートの青（#4a90d9）が残っていたので、アクセント変数へ。
   ここを直書きにしておくと、配色を切り替えても取り残されます */
.social-links a {
    padding: 0.4rem 1rem;
    border: 1px solid var(--accent);
    border-radius: 0px;
    color: var(--accent);
    text-decoration: none;
    font-size: 0.9rem;
    transition:
        background-color 0.2s ease,
        color 0.2s ease;
}

.social-links a:hover {
    background-color: var(--accent);
    color: var(--bg);
}

/* ============================================================
   狭い画面向けの調整

   ★必ずファイルの最後に置くこと★
   メディアクエリは詳細度を上げません。同じ強さの指定どうしでは
   「後に書いたほうが勝つ」ので、前に置くと下の .profile dd { flex: 1 }
   などに打ち消されて効きません。実際それで一度効きませんでした。
   ============================================================ */
@media (max-width: 520px) {
    /* プロフィール表を2段に折る。
       横一列のままだと値に123pxしか残らず、部活名が3行に折り返します */
    .profile > div { flex-wrap: wrap; gap: 0.15rem 1rem; }
    .profile dt { width: auto; }
    .profile dd { flex-basis: 100%; }

    /* スタッツは縦3枚だと長いので、2列に収まる幅まで下げる */
    .figures { grid-template-columns: repeat(auto-fit, minmax(118px, 1fr)); }
}

@media (max-width: 420px) {
    .intro { gap: 14px; }
    .intro__icon { width: 68px; }
    .profile-img { width: 68px; height: 68px; }
}
</style>


