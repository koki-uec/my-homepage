---
import Layout from '../layouts/Layout.astro';
import Countdown from '../components/Countdown.astro';
import LinkCard from '../components/LinkCard.astro';
import NowPlaying from '../components/NowPlaying.astro';
import LogList from '../components/LogList.astro';

import postData from '../data/posts.json';
import linkData from '../data/links.json';

// ダーツの記録はdarts.astro側のLOGに出すので、ここでは除く
const posts = postData.posts.filter((p) => p.src !== 'DARTS');
const links = linkData;
---

<Layout title="しーのホームページ">

	<div class="hero">
		<img src="/images/icon.jpg" alt="プロフィール写真" class="profile-img" />
		<div>
			<h1>しー</h1>
			<p class="role">電気通信大学 情報理工学域Ⅰ類</p>
			<p class="tagline">ダーツ / ドラム / リズムゲーム</p>
		</div>
	</div>

	<h2>COUNTDOWN</h2>
	<div class="chips">
		<Countdown label="軽音夏合宿まで" deadline="2026-09-04" />
		<Countdown label="調布祭まで" deadline="2026-11-20" />
	</div>

	<LogList posts={posts} />

	<h2>NOW PLAYING</h2>
	<NowPlaying />

	<h2>LINKS</h2>
	<div class="links">
		{links.map((l) => (
			<LinkCard name={l.name} url={l.url} note={l.note} icon={l.icon} />
		))}
	</div>

</Layout>

<style>
	/* ヘッダー */
	.hero {
		display: flex;
		align-items: center;
		gap: 22px;
		margin-bottom: 2.5rem;
	}

	.profile-img {
		width: 88px;
		height: 88px;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;      /* 名前が長くても写真は潰れない */
	}

	.hero h1 { font-size: 2.2rem; letter-spacing: 0.02em; }
	.hero .role { font-size: 0.85rem; color: var(--muted); margin-top: 2px; }

	/* 一言だけアクセント色*/
	.hero .tagline {
		font-size: 0.85rem;
		color: var(--accent);
		margin-top: 6px;
		letter-spacing: 0.04em;
	}

	/* カウントダウン 
	   狭い画面では自動で1列に落ちる。単位は落ちない */
	.chips {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1.2rem;
		margin-bottom: 2rem;
	}

	/* LOGの見た目は components/LogList.astro 側に移した
	   （Home・Darts両方から使うため、ここに置くと片方しか直らなくなる） */

	/* 相互リンク */
	.links {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 0.8rem;
		margin-bottom: 2rem;
	}

	/* --- 狭い画面 --- */
	@media (max-width: 420px) {
		.hero { gap: 16px; }
		.profile-img { width: 72px; height: 72px; }
		.hero h1 { font-size: 1.8rem; }
	}
</style>
