---
import Layout from '../layouts/Layout.astro';
import data from '../data/posts.json';
const posts = data.posts;
import Countdown from '../components/Countdown.astro';
---

<Layout title="しーのホームページ">
	<h1>こんにちは、しーです</h1>
	<p>電気通信大学の学生です。ここは私のホームページです。</p>

	<Countdown label="軽音夏合宿まで" deadline="2026-09-04" />
	<Countdown label="調布祭まで" deadline="2026-11-20" />

	<ul>
  {posts.map((post) => (
    <li>{post.src} - {post.date} — {post.text}</li>
  ))}
</ul>

</Layout>