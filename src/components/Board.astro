<div class="board" aria-hidden="true">

        <!-- ここから中身が丸ごと回る。見た目と当たり判定をズラさないため -->
        <div class="board__spin">

          <!-- 得点が入る円。JSはこの円のサイズを測って判定する -->
          <div class="board__play">
            <div class="board__face"></div>
            <div class="board__band board__band--triple"></div>
            <div class="board__band board__band--double"></div>
            <div class="board__bull-out"></div>
            <div class="board__bull"></div>
          </div>

          <!-- 数字は得点エリアの外側に並ぶ -->
          <ul class="board__numbers">
            <li style="--i:0" data-target><span>20</span></li>
            <li style="--i:1"><span>1</span></li>
            <li style="--i:2"><span>18</span></li>
            <li style="--i:3"><span>4</span></li>
            <li style="--i:4"><span>13</span></li>
            <li style="--i:5"><span>6</span></li>
            <li style="--i:6"><span>10</span></li>
            <li style="--i:7"><span>15</span></li>
            <li style="--i:8"><span>2</span></li>
            <li style="--i:9"><span>17</span></li>
            <li style="--i:10"><span>3</span></li>
            <li style="--i:11"><span>19</span></li>
            <li style="--i:12"><span>7</span></li>
            <li style="--i:13"><span>16</span></li>
            <li style="--i:14"><span>8</span></li>
            <li style="--i:15"><span>11</span></li>
            <li style="--i:16"><span>14</span></li>
            <li style="--i:17"><span>9</span></li>
            <li style="--i:18"><span>12</span></li>
            <li style="--i:19"><span>5</span></li>
          </ul>

        </div>

        <!-- 得点の表示。回らないので board__spin の外に置く -->
        <p class="board__score"></p>
</div>

<style>
    /* ダーツボード
    中身はすべて % で組んであるので、.board の width を変えれば全体が拡大縮小します */
    .board {
    --size: 220px;              /* 盤の大きさはここ1箇所で決める */
    position: relative; width: var(--size); height: var(--size);
    flex-shrink: 0; cursor: crosshair;

    /* ★連打したときに数字が選択されて青くならないように★
        速くクリックするとブラウザはダブルクリック＝文字の選択と解釈します。
        盤は「投げる場所」であって読む文字ではないので、選択を切ります。 */
    -webkit-user-select: none;
            user-select: none;
    /* スマホでタップしたときに出る灰色の矩形も消す */
    -webkit-tap-highlight-color: transparent;
    }
    .board::before {
    content: ""; position: absolute; inset: -18%;
    background: radial-gradient(circle, rgba(233,161,59,.14), transparent 65%);
    }

    /* 回る部分をまとめる箱。面も帯も数字も、これ1つで一緒に回る＝見た目と当たり判定がズレない */
    .board__spin { position: absolute; inset: 0; animation: spin 160s linear infinite; }
    /* マウスを乗せたら止まる＝狙いやすくする */
    .board:hover .board__spin { animation-play-state: paused; }

    /* 得点が入る円。数字はこの外側に並ぶので、盤の84%にしている。
    ここの % を変えても、JSはこの円の実サイズを測る作りなので直さなくてOK */
    .board__play {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
    width: 84%; height: 84%; border-radius: 50%;
    }

    /* ★20分割の面★
    conic-gradient は「角度で色を塗る」グラデーション。
    from -9deg にすると、最初の1枚（＝20）がちょうど真上に来る。
    背景を2枚重ねている：上が18度ごとのワイヤー（細い区切り線）、
    下がくさびの明暗。どちらもごく薄く、線で見せるのが狙い */
    .board__face {
    position: absolute; inset: 0; border-radius: 50%;
    background:
        repeating-conic-gradient(from -9deg,
        rgba(236,228,216,.16) 0deg .6deg, transparent .6deg 18deg),
        repeating-conic-gradient(from -9deg,
        rgba(236,228,216,.022) 0deg 18deg, transparent 18deg 36deg),
        /* ★一番下は不透明にする★
        ここを透かすと、board::before のアンバーの光が盤全体に透けて濁る */
        radial-gradient(circle at 50% 36%, #191514, #100D0C 80%);
    border: 1px solid var(--line);
    }

    /* ダブル／トリプルの帯。
    普段はうっすら、カーソルを乗せた（＝狙っている）ときだけはっきりする */
    .board__band {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
    border-radius: 50%;
    opacity: .38; transition: opacity .4s ease;
    }
    .board:hover .board__band { opacity: 1; }

    /* ★mask で真ん中をくり抜いてリングにする★
    mask は「不透明なところだけ表示、透明なところは消す」型抜き。
    closest-side を使うと、この要素の半径が100%基準になる。
    → 86%までは消す ＝ 86%〜100% のドーナツだけが残る */
    .board__band--triple {
    width: 64%; height: 64%;
    background: repeating-conic-gradient(from -9deg,
        rgba(233,161,59,.40) 0deg 18deg, rgba(233,161,59,.09) 18deg 36deg);
    -webkit-mask-image: radial-gradient(closest-side, transparent 86%, #000 86%);
            mask-image: radial-gradient(closest-side, transparent 86%, #000 86%);
    }
    .board__band--double {
    width: 100%; height: 100%;
    background: repeating-conic-gradient(from -9deg,
        rgba(178,58,47,.55) 0deg 18deg, rgba(178,58,47,.13) 18deg 36deg);
    -webkit-mask-image: radial-gradient(closest-side, transparent 91%, #000 91%);
            mask-image: radial-gradient(closest-side, transparent 91%, #000 91%);
    }

    /* ★保険★
    万一 mask に対応していないブラウザだと、くり抜きが効かず
    「ただの赤い円」が盤全体を覆って表示が潰れる。
    @supports は「この書き方に対応していたら／いなかったら」を判定する仕組み。
    対応していないときだけ帯を消して、線画の盤として成立させる。
    （当たり判定はJS側なので、見た目が減っても得点は正しく出ます） */
    @supports not ((-webkit-mask-image: radial-gradient(#000, #000))
                or (mask-image: radial-gradient(#000, #000))) {
    .board__band { display: none; }
    }

    /* ブル。外側は輪郭だけ（25点）、内側は赤い点（50点） */
    .board__bull-out {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
    width: 13%; height: 13%; border-radius: 50%;
    border: 1px solid rgba(236,228,216,.22);
    }
    .board__bull {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
    width: 6%; height: 6%; border-radius: 50%; background: var(--red);
    box-shadow: 0 0 12px rgba(178,58,47,.9);
    }

    /* ★仕組み★ liを18度ずつ回す（360÷20=18）。中のspanは上端中央にあるので円周上を動く */
    .board__numbers { position: absolute; inset: 0; }
    .board__numbers li { position: absolute; inset: 0; transform: rotate(calc(var(--i) * 18deg)); }
    .board__numbers span {
    position: absolute; top: 0; left: 50%; transform: translateX(-50%);
    font-family: var(--font-display); font-size: 14px; line-height: 1.2; color: var(--muted);
    }
    .board__numbers li[data-target] span { color: var(--accent); }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* クリックしたときに一瞬出る得点 */
    .board__score {
    position: absolute; inset: 0;
    display: grid; place-items: center;
    font-family: var(--font-display); font-size: 24px; letter-spacing: .14em;
    color: var(--text);        /* シングルとミスは白 */
    text-shadow: 0 0 18px var(--bg), 0 0 8px var(--bg), 0 0 3px var(--bg);
    pointer-events: none;      /* ★これが無いと文字がクリックを吸ってしまう */
    opacity: 0;
    }
    /* ★トリプル・ダブル・ブルだけアンバー★
    付け外しは script.js の isPremium() が判断しています。
    光も色に合わせると、白と黄色の差がはっきり出ます。 */
    .board__score.is-hi {
    color: var(--accent);
    text-shadow: 0 0 20px var(--bg), 0 0 8px var(--bg),
                0 0 26px rgba(233,161,59,.45);
    }

    /* 中央に出したまま留めず、上へ抜けながら消える。
    ★等速直線運動★ タイミング関数を linear にして、
    移動量もキーフレームの割合どおり（10%の時点で全体の10%＝6px）にしてある。
    これで加速も減速もせず、一定の速さで上がっていく。 */
    .board__score.is-on { animation: score-float 1.1s linear forwards; }

    @keyframes score-float {
    0%   { opacity: 0; transform: translateY(0); }
    10%  { opacity: 1; transform: translateY(-6px); }    /* ここまでで一気に出す */
    100% { opacity: 0; transform: translateY(-60px); }   /* あとは同じ速さで上へ */
    }

    .board__numbers { position: absolute; inset: 0; margin: 0; padding: 0; }

</style>

