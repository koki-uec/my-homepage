---
const { label, value, note } = Astro.props;
---

<div class="statcard">
    <h3>{label}</h3>
    <p>{value} {note && <small>{note}</small>}</p>
</div>

<style>
    .statcard {
        border: 1px solid var(--line);   /* 直書きやめて！変数にして！ */
        padding: 0.8rem 0.9rem;
    }
    /* ★ブラウザ既定の余白を消す★
       <h3> と <p> には margin が自動で付きます。
       数字が大きいほど margin も大きくなる（1em＝文字サイズぶん）ので、
       ここを消さないとカードが中身の倍の高さになります。 */
    .statcard h3, .statcard p { margin: 0; }

    .statcard h3 {
        font-family: var(--font-jp);     /* ラベルは本文書体のまま */
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        color: var(--muted);
        font-weight: 400;
        margin-bottom: 0.2rem;
    }
    /* 見出し書体に乗せる。
       横並びにしたぶん、1枚あたりは控えめでよくなりました */
    .statcard p {
        font-family: var(--font-display);
        font-size: 1.9rem;
        line-height: 1.1;
        color: var(--text);
    }
    .statcard small {
        font-size: 0.8rem;
        color: var(--muted);
        margin-left: 0.2em;
    }
</style>