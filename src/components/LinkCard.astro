---
const { name, url, note, icon } = Astro.props;
---

<a class="linkcard" href={url} target="_blank" rel="noopener noreferrer">
    {icon
        ? <img class="linkcard__icon" src={icon} alt="" />
        : <span class="linkcard__icon linkcard__icon--letter">{[...name][0]}</span>}

    <span class="linkcard__body">
        <b>{name}</b>
        {note && <small>{note}</small>}
    </span>
</a>

<style>
    /* アイコン・名前・ひとことを1つの箱にまとめたブロック */
    .linkcard {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.85rem 1rem;
        border: 1px solid var(--line);
        color: inherit;
        text-decoration: none;
        transition: border-color 0.2s ease, color 0.2s ease;
    }
    .linkcard:hover {
        border-color: var(--accent);
        color: var(--accent);
    }

    .linkcard__icon {
        width: 40px;
        height: 40px;
        flex-shrink: 0;      /* 名前が長くてもアイコンは潰れない */
        border-radius: 50%;
        object-fit: cover;
    }

    /* 画像が無いとき
       頭文字を丸に入れて出す*/
    .linkcard__icon--letter {
        display: grid;
        place-items: center;
        background: var(--panel);
        color: var(--accent);
        font-family: var(--font-display);
        font-size: 1rem;
    }

    .linkcard__body {
        display: flex;
        flex-direction: column;
        min-width: 0;        /* 長い名前がはみ出さないように */
    }
    .linkcard__body b { font-weight: 500; font-size: 0.95rem; }
    .linkcard__body small { font-size: 0.75rem; color: var(--muted); margin-top: 2px; }
</style>
