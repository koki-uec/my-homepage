---
/* HomeとDartsで「LOG」の見た目・絞り込みを共有するための部品。
   全く同じCSSとJSを2ファイルに複製すると、直すときに片方だけ直して
   もう片方を忘れる、という事故が起きやすいのでここにまとめておく */

type Post = { date: string; src: string; text: string };

const { posts } = Astro.props as { posts: Post[] };

// 渡された posts の中にある種類だけを集める。
// ★渡された配列が基準★ Darts側は最初からDARTSしか渡さないので、
//   ここで作る kinds も自動的に ['DARTS'] だけになる
const kinds = [...new Set(posts.map((p) => p.src))];

// 種類が1つしかないなら、絞り込みボタンを出す意味がない
const showFilter = kinds.length > 1;
---

<h2>LOG</h2>

{showFilter && (
	<div class="log-filter">
		{kinds.map((kind) => (
			<button type="button" data-filter={kind}>{kind}</button>
		))}
	</div>
)}

<ul class="posts">
	{posts.map((post) => (
		<li data-src={post.src}>
			<time>{post.date}</time>
			<span class="tag">{post.src}</span>
			<span class="post__text">{post.text}</span>
		</li>
	))}
</ul>

<style>
	.posts { border-top: 1px solid var(--line); margin-bottom: 2rem; }

	.posts li {
		display: flex;
		gap: 1rem;
		align-items: baseline;
		padding-block: 0.7rem;
		border-bottom: 1px solid var(--line);
		font-size: 0.9rem;
	}

	/* 絞り込み必須ゾーン
	   hidden は「[hidden] { display: none }」が当たっるだけ
	   上の .posts li { display: flex } のほうが強い*/
	.posts li[hidden] { display: none; }

	.posts time { width: 7em; flex-shrink: 0; color: var(--muted); font-size: 0.8rem; }
	.posts .tag { width: 4.5em; flex-shrink: 0; font-size: 0.65rem; letter-spacing: 0.1em; color: var(--accent); }

	.log-filter { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.2rem; }

	.log-filter button {
		font-family: inherit;
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		cursor: pointer;
		padding: 0.35rem 0.9rem;
		background: none;
		border: 1px solid var(--line);
		border-radius: 0;
		color: var(--muted);
		transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
	}
	.log-filter button:hover { color: var(--accent); border-color: var(--accent); }

	.log-filter button.is-active {
		background-color: var(--accent);
		border-color: var(--accent);
		color: var(--bg);
	}

	@media (max-width: 520px) {
		.posts li { flex-wrap: wrap; gap: 0.2rem 0.8rem; }
		.posts time { width: auto; }
		.posts .tag { width: auto; }
		.posts .post__text { flex-basis: 100%; }

		.log-filter button { padding: 0.5rem 1rem; }
	}
</style>

<script>
	/* ボタンが無いページ（絞り込み不要な1種類だけのLOG）では
	   querySelectorAll が0件を返すだけなので、このまま動いてOK */
	const buttons = document.querySelectorAll<HTMLElement>('.log-filter button');
	const items = document.querySelectorAll<HTMLElement>('.posts li');

	buttons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const kind = btn.dataset.filter;
			const wasActive = btn.classList.contains('is-active');

			buttons.forEach((b) => b.classList.remove('is-active'));

			if (wasActive) {
				items.forEach((li) => { li.hidden = false; });
				return;
			}

			btn.classList.add('is-active');
			items.forEach((li) => {
				li.hidden = li.dataset.src !== kind;
			});
		});
	});
</script>
