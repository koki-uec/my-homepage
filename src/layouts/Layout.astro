---
const { title } = Astro.props;
import '../styles/global.css';
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- 書体は1本にまとめる。&family= でつなげば1回のリクエストで済む。
		     Oswald は外した（コンデンス体は「硬派・バー」の記号で、今回の方向と逆） -->
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header>
			<nav>
				<a href="/">Home</a>
				<a href="/about">About</a>
				<a href="/reviews">Reviews</a>
				<a href="/works">Works</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<slot name="outside" /> 
		<!-- outsideのslotとして指定したらmain以下footer以上の部分に出るようにしてるよん -->

		<footer>© 2026  しー</footer>
	</body>
</html>

<style>
	body {
		max-width: 720px;
		margin: 0 auto;
		padding: 2rem 1.5rem;
		/* ★直書きをやめて変数へ★
		   ここが直書きのままだと、global.css の --font-jp を変えても本文が変わりません。
		   しかも Layout の <style> は「スコープ付き」で優先度が高いので、
		   global.css 側に body { font-family } を書いても勝てません。 */
		font-family: var(--font-jp);
		line-height: 1.8;
		color: var(--text);
		background-color: var(--bg);
	}

	nav {
		display: flex;
		gap: 1.5rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--line);
	}

	nav a {
		color: var(--muted);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	nav a:hover {
		color: var(--accent);
	}

	main {
		background-color: var(--panel);
		border-radius: 0px;
		/* box-shadow: 0 2px 16px rgba(0, 0, 0, 0.08); */
		padding: 2rem;
		margin-top: 1.5rem;
	}

	footer {
		margin-top: 2rem;
		padding-top: 1rem;
		font-size: 0.85rem;
		color: var(--muted);
	}
</style>