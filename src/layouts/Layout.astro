---
const { title } = Astro.props;
import '../styles/global.css';
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>

		<!-- iconはタブに出した時のアイコンで、
		     apple-touch-icon はiPhoneでホーム画面に追加したときのアイコン。そこまで指定できるんかい -->
		<link rel="icon" href="/images/favicon.jpg" />
		<link rel="apple-touch-icon" href="/images/icon.jpg" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header>
			<nav>
				<a href="/">Home</a>
				<a href="/about">About</a>
				<a href="/reviews">Reviews</a>
				<a href="/works">Works</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<!-- outsideのslotとして指定したらmain以下footer以上の部分に出るようにしてる。
		     囲いが要るのは、body の幅制限を外すと中身が全幅になるかららしい -->
		<div class="outside">
			<slot name="outside" />
		</div>

		<footer>© 2026  しー</footer>
	</body>
</html>

<style>
	body {
		margin: 0;
		padding: 0;
		font-family: var(--font-jp);
		line-height: 1.8;
		color: var(--text);
		background-color: var(--bg);
	}

	/* 中身の幅をここでまとめて決める。
	   ヘッダーの帯だけが全幅、中のナビは本文と同じ幅で揃う*/
	nav,
	main,
	.outside,
	footer {
		max-width: 720px;
		margin-inline: auto;
		padding-inline: 1.5rem;
	}

	/* position: stickyキターーー🤩 */
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background-color: var(--bg);
		padding-top: 0.9rem;
		/* 罫線は nav ではなくヘッダーに引く。
		   nav に引くと本文幅で途切れちゃう */
		border-bottom: 1px solid var(--line);
	}

	nav {
		display: flex;
		gap: 1.5rem;
		padding-bottom: 0.7rem;
	}

	nav a {
		color: var(--muted);
		text-decoration: none;
		transition: color 0.2s ease;
		/* 指で押す面積を確保する。文字の高さは29pxしかないので、
		   上下に余白を足して押しやすくしてる。なんて親切！ */
		padding-block: 0.4rem;
	}

	nav a:hover {
		color: var(--accent);
	}

	main {
		background-color: var(--panel);
		border-radius: 0px;
		/* 左右の余白は上の共通ルールが持っているので、ここは上下だけ */
		padding-block: 2rem;
		margin-top: 1.5rem;
	}

	footer {
		margin-top: 2rem;
		padding-top: 1rem;
		padding-bottom: 2rem;
		font-size: 0.85rem;
		color: var(--muted);
	}

	/*ここからは狭い画面向けの調整。必ずファイルの最後に置こう。*/
	@media (max-width: 520px) {
		nav,
		main,
		.outside,
		footer { padding-inline: 1rem; }

		main { padding-block: 1.4rem; }

		nav { gap: 1.1rem; overflow-x: auto; padding-bottom: 0.5rem; }
		nav a { white-space: nowrap; }

		/* スマホは画面の高さが大事だから固定ヘッダーをさらに薄くする */
		header { padding-top: 0.6rem; }
	}
</style>